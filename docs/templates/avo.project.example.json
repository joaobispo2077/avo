{
  "$schema": "../../schemas/avo.project.schema.json",
  "provider": "my-channel",
  "rawDir": "/absolute/path/to/footage/my-video",
  "title": "Working title",
  "assets": {
    "sfx": "/absolute/path/to/assets/sfx",
    "music": "/absolute/path/to/assets/music",
    "inserts": "",
    "graphics": "",
    "logos": "providers/my-channel/logo"
  },
  "transcription": {
    "language": "en"
  },
  "captions": {
    "identity": "anchor",
    "burnedIn": true,
    "platformCaptions": false
  },
  "rights": {
    "auditPath": "edit/review/rights-audit.md",
    "earlyPass": false
  },
  "audioQc": {
    "auditPath": "edit/review/audio-qc.md",
    "channelTargetNote": "Document internal target in provider notes — not a universal platform number"
  },
  "deliverable": {
    "profile": "long-form",
    "maxDurationSec": 60,
    "aspect": "16:9"
  },
  "chapters": {
    "path": "edit/delivery/chapters.txt"
  },
  "thumbnails": {
    "dir": "edit/delivery/thumbnails/"
  },
  "endScreen": {
    "checklistPath": "edit/review/end-screen-checklist.md"
  },
  "colorQc": {
    "auditPath": "edit/review/color-qc.md"
  },
  "syncCheck": {
    "auditPath": "edit/review/sync-check.md"
  },
  "formatDiagnosis": {
    "auditPath": "edit/review/format-diagnosis.md"
  },
  "frameworkSelection": {
    "auditPath": "edit/review/framework-selection.md"
  },
  "gradeNotes": {
    "auditPath": "edit/review/grade-notes.md"
  },
  "reframe": {
    "sourceMaster": "edit/masters/YYYYMMDD-slug-master-v001.mp4",
    "from": "4:10",
    "to": "4:55",
    "cropStrategy": "face-safe"
  },
  "approvalGates": {
    "requireHumanSignOff": true,
    "checkpoints": ["edit-proof", "motion-proof", "pre-master"]
  }
}
