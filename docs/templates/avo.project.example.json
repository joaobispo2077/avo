{
  "$schema": "../../schemas/avo.project.schema.json",
  "provider": "my-channel",
  "rawDir": "/absolute/path/to/footage/my-video",
  "title": "Working title",
  "assets": {
    "sfx": "/absolute/path/to/assets/sfx",
    "music": "/absolute/path/to/assets/music",
    "inserts": "",
    "graphics": "",
    "logos": "providers/my-channel/logo"
  },
  "transcription": {
    "language": "en"
  },
  "captions": {
    "identity": "anchor",
    "burnedIn": true,
    "platformCaptions": false
  },
  "deliverable": {
    "profile": "long-form",
    "maxDurationSec": 60,
    "aspect": "16:9"
  },
  "reframe": {
    "sourceMaster": "edit/masters/YYYYMMDD-slug-master-v001.mp4",
    "from": "4:10",
    "to": "4:55",
    "cropStrategy": "face-safe"
  },
  "approvalGates": {
    "requireHumanSignOff": true,
    "checkpoints": ["edit-proof", "motion-proof", "pre-master"]
  }
}
