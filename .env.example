# AVO environment example — copy to .env and fill only what you use.
# .env is gitignored; never commit real keys.

# Optional override for prepared local Whisper models (transcription stays local).
# Model cache directory (optional). AVO_MODEL_DIR is preferred; VIDEO_USE_MODEL_DIR is legacy alias.
AVO_MODEL_DIR=~/.cache/video-use/models
# VIDEO_USE_MODEL_DIR=~/.cache/video-use/models

# --- Optional "Paid" providers (leave unset to stay fully local) ---
# Transcription (Paid alternative to local faster-whisper):
# ELEVENLABS_API_KEY=

# Logo showcase images (logo-generator-skill; SVG path works without this):
# GEMINI_API_KEY=

# Render/encode (Paid alternative to local render):
# GEMINI_FLOW_API_KEY=
