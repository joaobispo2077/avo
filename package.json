{
  "name": "avo",
  "version": "1.0.1",
  "description": "Edit less, create more \u2014 local-first AI video orchestrator. Talk to your agent, drop in footage, mass-produce YouTube-ready videos per channel.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "scripts": {
    "setup": "cross-env AVO_SETUP=1 node scripts/run-native.mjs setup",
    "install:agents": "node bin/install.cjs",
    "new-provider": "uv run --frozen python -m avo.provider_scaffold",
    "init-project": "uv run --frozen python -m avo.init_project",
    "check-update": "uv run --frozen python -m avo.update check",
    "update": "uv run --frozen python -m avo.update apply",
    "validate:prerequisites": "uv run --frozen python -m avo.validate_dependencies",
    "validate:usability": "uv run --frozen python -m avo.validate_usability",
    "test:unit": "uv run --frozen --extra dev pytest -s --ignore=tests/projects -m \"not project\"",
    "test:projects": "uv run --frozen --extra dev pytest -s tests/projects",
    "hf": "hyperframes",
    "hf:doctor": "hyperframes doctor",
    "hf:skills": "hyperframes skills",
    "hf:skills:update": "hyperframes skills update",
    "hf:init": "hyperframes init",
    "hf:capture": "hyperframes capture",
    "hf:lint": "hyperframes lint",
    "hf:check": "hyperframes check",
    "hf:snapshot": "hyperframes snapshot",
    "hf:preview": "hyperframes preview",
    "hf:render": "hyperframes render",
    "release": "semantic-release",
    "release:local": "semantic-release --no-ci",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "cross-env": "^7.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.14.2",
    "hyperframes": "^0.7.69",
    "rimraf": "^6.0.0",
    "semantic-release": "^25.0.3",
    "shx": "^0.3.4"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "bin": {
    "avo-install": "bin/install.cjs"
  }
}
