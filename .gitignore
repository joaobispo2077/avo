# =============================================================================
# AVO — AI Video Orchestrator .gitignore
# -----------------------------------------------------------------------------
# Structure:
#   1. Node baseline (github/gitignore Node.gitignore)
#   2. Python / virtual environments
#   3. Editors / IDEs / OS cruft
#   4. Media & session artifacts (outputs live under <footage>/edit/, not here)
#   5. AVO working data: specs, models, scratch, backups, secrets, state
#
# NOTE: Dev SDD trees (`.cursor/`, `.sdd/`) and vendored skills (`.agents/`,
# `.claude/`) are gitignored for GitHub launch — see docs/repo-layout.md.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Node baseline (github/gitignore Node.gitignore)
# -----------------------------------------------------------------------------
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# -----------------------------------------------------------------------------
# 2. Python / virtual environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (native + WSL)
.venv/
.venv-wsl/
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# 3. Editors / IDEs / OS cruft
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# 4. Media & session artifacts
#    Session outputs belong under <footage>/edit/ — these are a safety net for
#    when a skill is accidentally invoked inside the repo directory.
# -----------------------------------------------------------------------------
media/
edit/
transcripts/
animations/
clips_graded/
clips_preview/
downloads/
verify/
preview.mp4
final.mp4
base.mp4
base_preview.mp4
master.srt
takes_packed.md
edl.json
project.md

# Provider / project MEDIA is always external. Never commit raw or edit media.
# Provider manifests store external paths only (see providers/<name>/avo.provider.json).

# Personal provider instances — schema + _template ship; real channels stay local.
providers/*/
!providers/_template/
!providers/_template/**

# -----------------------------------------------------------------------------
# 5. AVO working data — personal specs, models, scratch, backups, secrets, state
# -----------------------------------------------------------------------------
# Personal video projects & SDD working specs (private footage references).
specs/
!specs/backlog/
!specs/backlog/**

# Local Whisper / LLM model caches.
models/

# Scratch / temp dirs.
@tmp/
tmp/

# Stray scratch file at repo root.
/-16

# Timestamped backup files (e.g. AGENTS.md.bak-1785595410).
*.bak-*

# Secrets (belt-and-suspenders; also covered by the Node dotenv rules above).
.env
.env.*
*.pem
*.key

# AVO runtime state (version + lastUpdateCheck + rolling telemetry stats).
.avo/

# ai-jail overlay/working dirs.
.ai-jail-overlays/

# Orchestrator tool clones (setup.sh / Gate 1 shallow-clone; stay external to AVO source)
tools/watch-skill/
tools/ai-memory/
tools/logo-generator-skill/
tools/ai-jail/
tools/video-use-upstream/
tools/bin/
tools/__pycache__/
tools/*.py
tools/animation_design/

# Session one-off scripts at repo root tools/ — keep README only
# (negation below if we add tracked tooling later)

# Vendored agent skills (install via hyperframes skills update — not AVO source)
.agents/
.claude/
skills-lock.json

# SDD / multi-agent dev tooling (not shipped on GitHub)
.cursor/
.sdd/
.cursor-plugin/
.chatgpt/
.opencode/
.windsurf/
.clinerules/

# Local demo / scratch (HyperFrames experiments, media assets)
compositions/
assets/
lib/

# Legacy optional skills tree
skills/
!agent-skills/
!agent-skills/**

# Python build metadata
*.egg-info/
avo.egg-info/
video_use.egg-info/

# Local ai-memory config
.ai-memory.toml

# Root session logs — templates live under docs/templates/logs/
/EDITLOG.md
/STORYBOARD.md
/*-LOG.md

# -----------------------------------------------------------------------------
# Tracked exceptions (negations must come AFTER the ignores above)
# -----------------------------------------------------------------------------
# Keep the env template tracked so contributors know which optional keys exist.
!.env.example
