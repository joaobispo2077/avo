{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "bin/**/*.ts",
    "configs/**/*.ts",
    "lib/**/*.ts",
    "tests/infra/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "docs/exemplars"]
}
