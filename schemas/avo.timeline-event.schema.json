{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.timeline-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "type",
    "occurredAt",
    "actor",
    "subject",
    "reason"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "revision-created",
        "approved",
        "rejected",
        "changes-requested",
        "promotion-approved",
        "shelved",
        "superseded",
        "invalidated",
        "recovered",
        "migration-recorded",
        "locator-updated"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "agent",
            "migration",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "revisionId",
        "contentSha256"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencyHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dependencyLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidenceBundleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "details": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "approved",
              "rejected",
              "changes-requested",
              "promotion-approved"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "checkpoint",
          "candidateSha256",
          "dependencyHashes",
          "dependencyLockSha256",
          "scope",
          "evidenceBundleSha256"
        ],
        "properties": {
          "dependencyHashes": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
