{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.timeline-learning.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "videoId", "provider", "status", "masterFingerprint", "candidateSnapshotHash", "iterationLedgerHash", "reconstructionBundleHash", "decisionOutcomes", "reworkGroups", "preventionRules", "capabilityGaps", "costSignals", "techniqueCandidates", "uncertainties", "createdAt", "snapshotHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "snapshotId": { "$ref": "#/$defs/stableId" }, "videoId": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "status": { "enum": ["draft", "final"] }, "masterFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] }, "candidateSnapshotHash": { "$ref": "#/$defs/sha256" }, "iterationLedgerHash": { "$ref": "#/$defs/sha256" }, "reconstructionBundleHash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "decisionOutcomes": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "reworkGroups": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "preventionRules": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "capabilityGaps": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "costSignals": { "type": "object", "additionalProperties": { "type": ["number", "integer", "null"] } }, "techniqueCandidates": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/sanitizedRecord" } }, "createdAt": { "type": "string", "minLength": 1 }, "snapshotHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "final" } } }, "then": { "properties": { "masterFingerprint": { "$ref": "#/$defs/fingerprint" } } } }],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }, "fingerprint": { "type": "object", "additionalProperties": false, "required": ["sha256", "sizeBytes"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "locator": { "type": "string", "minLength": 1 } } }, "sanitizedRecord": { "type": "object", "additionalProperties": false, "required": ["id", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "status": { "type": "string" }, "evidenceClasses": { "type": "array", "items": { "type": "string" } }, "impact": { "type": "object", "additionalProperties": true }, "recurrence": { "type": "integer", "minimum": 0 } } } }
}
