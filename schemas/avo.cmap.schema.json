{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joaobispo2077/avo/schemas/avo.cmap.schema.json",
  "title": "AVO Canonical Cut Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "videoId",
    "provider",
    "timelineDomain",
    "currentRevisionId",
    "approvedRevisionId",
    "revisions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifactType": {
      "const": "cmap"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "videoId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "timelineDomain": {
      "const": "raw-source"
    },
    "currentRevisionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvedRevisionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "default": []
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timelineDomain": {
      "type": "string",
      "enum": [
        "raw-source",
        "sync-corrected-source",
        "cmap-output"
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaSignature": {
          "type": "object"
        },
        "locator": {
          "type": "string"
        }
      }
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks",
        "timebase",
        "domain"
      ],
      "properties": {
        "ticks": {
          "type": "integer"
        },
        "timebase": {
          "$ref": "#/$defs/timebase"
        },
        "domain": {
          "$ref": "#/$defs/timelineDomain"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "raw-source",
                  "sync-corrected-source"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "required": [
              "sourceId"
            ]
          }
        }
      ]
    },
    "dependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "artifactId",
        "revisionId",
        "sha256",
        "state"
      ],
      "properties": {
        "artifactType": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "state": {
          "type": "string",
          "enum": [
            "valid",
            "stale",
            "blocked",
            "superseded"
          ]
        }
      }
    },
    "diffOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "targetId",
        "reason"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "remove",
            "replace",
            "move",
            "split",
            "merge"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "before": {},
        "after": {},
        "timeSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/timeValue"
            },
            "end": {
              "$ref": "#/$defs/timeValue"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sha256"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decision",
        "revisionId",
        "revisionHash",
        "candidateHash",
        "dependencyHashes",
        "actor",
        "decidedAt"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "changes-requested",
            "revoked"
          ]
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "revisionHash": {
          "$ref": "#/$defs/sha256"
        },
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "dependencyHashes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "scope": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "parentRevisionId",
        "createdAt",
        "actor",
        "reason",
        "snapshot",
        "diff",
        "dependencies",
        "contentHash",
        "evidence",
        "state"
      ],
      "properties": {
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "parentRevisionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "#/$defs/cmapSnapshot"
        },
        "diff": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diffOperation"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "review-ready",
            "approved",
            "rejected",
            "superseded",
            "stale",
            "blocked",
            "unknown"
          ]
        }
      }
    },
    "rawSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "kind",
        "fingerprint"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "raw"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "locator": {
          "type": "string"
        },
        "streamMetadata": {
          "type": "object"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "sourceId",
        "in",
        "out",
        "reason"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "$ref": "#/$defs/timeValue"
        },
        "out": {
          "$ref": "#/$defs/timeValue"
        },
        "storySectionId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layoutEvidence": {"enum": ["export", "probe", "editor-declaration", "capability-check", "unverified"]},
    "programTime": {"allOf": [{"$ref": "#/$defs/timeValue"}, {"properties": {"domain": {"const": "cmap-output"}}, "not": {"required": ["sourceId"]}}]},
    "layoutTrack": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "kind", "order", "enabled", "muted", "evidenceOrigin"],
      "properties": {
        "trackId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["video", "audio"]},
        "order": {"type": "integer", "minimum": 0},
        "enabled": {"type": "boolean"}, "muted": {"type": "boolean"},
        "name": {"type": "string"}, "evidenceOrigin": {"$ref": "#/$defs/layoutEvidence"}
      }
    },
    "layoutAudioSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["streamIndex", "channels", "sourceLayout", "outputLayout", "sourceSampleRate"],
      "properties": {
        "streamIndex": {"type": "integer", "minimum": 0},
        "channels": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "sourceLayout": {"type": "string", "minLength": 1},
        "outputLayout": {"enum": ["stereo", "dual-mono"]},
        "sourceSampleRate": {"type": "integer", "minimum": 1}
      }
    },
    "layoutPlacement": {
      "type": "object", "additionalProperties": false,
      "required": ["placementId", "elementId", "trackId", "sourceId", "mediaKind", "in", "out", "start", "end", "enabled", "routing", "evidenceOrigin"],
      "properties": {
        "placementId": {"type": "string", "minLength": 1}, "elementId": {"type": "string", "minLength": 1},
        "trackId": {"type": "string", "minLength": 1}, "sourceId": {"type": "string", "minLength": 1},
        "mediaKind": {"enum": ["video", "still", "audio"]},
        "in": {"$ref": "#/$defs/timeValue"}, "out": {"$ref": "#/$defs/timeValue"},
        "start": {"$ref": "#/$defs/programTime"}, "end": {"$ref": "#/$defs/programTime"},
        "enabled": {"type": "boolean"}, "muted": {"type": "boolean"},
        "gainDb": {"type": "number", "minimum": -60, "maximum": 24},
        "routing": {
          "type": "object", "additionalProperties": false,
          "properties": {"videoStreamIndex": {"type": "integer", "minimum": 0}, "audioSelection": {"$ref": "#/$defs/layoutAudioSelection"}}
        },
        "evidenceOrigin": {"$ref": "#/$defs/layoutEvidence"}
      },
      "allOf": [
        {"if": {"properties": {"mediaKind": {"const": "audio"}}}, "then": {"properties": {"routing": {"required": ["audioSelection"], "not": {"required": ["videoStreamIndex"]}}}}, "else": {"properties": {"routing": {"required": ["videoStreamIndex"], "not": {"required": ["audioSelection"]}}, "gainDb": {"const": 0}, "muted": {"const": false}}}}
      ]
    },
    "layoutGap": {
      "type": "object", "additionalProperties": false,
      "required": ["gapId", "trackId", "start", "end", "evidenceOrigin"],
      "properties": {
        "gapId": {"type": "string", "minLength": 1}, "trackId": {"type": "string", "minLength": 1},
        "start": {"$ref": "#/$defs/programTime"}, "end": {"$ref": "#/$defs/programTime"},
        "evidenceOrigin": {"$ref": "#/$defs/layoutEvidence"}
      }
    },
    "placedLayout": {
      "type": "object", "additionalProperties": false,
      "required": ["programClock", "duration", "displayOrigin", "background", "tracks", "placements", "gaps"],
      "properties": {
        "programClock": {"type": "object", "additionalProperties": false, "required": ["frameRate", "timebase", "audioSampleRate"], "properties": {"frameRate": {"$ref": "#/$defs/timebase"}, "timebase": {"$ref": "#/$defs/timebase"}, "audioSampleRate": {"type": "integer", "minimum": 1}}},
        "duration": {"$ref": "#/$defs/programTime"}, "displayOrigin": {"type": ["object", "null"]}, "background": {"const": "black"},
        "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutTrack"}},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/layoutPlacement"}},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/layoutGap"}}
      }
    },
    "cmapSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {"originRef": ["sourceAssemblyPolicy", "importOutput"], "sourceAssemblyPolicy": ["originRef", "importOutput"], "importOutput": ["originRef", "sourceAssemblyPolicy"]},
      "required": [
        "sources"
      ],
      "oneOf": [
        {"required": ["segments"], "not": {"anyOf": [{"required": ["layoutMode"]}, {"required": ["layout"]}]}},
        {"required": ["layoutMode", "layout", "originRef", "sourceAssemblyPolicy", "importOutput"], "not": {"required": ["segments"]}}
      ],
      "properties": {
        "layoutMode": {"const": "placed"},
        "layout": {"$ref": "#/$defs/placedLayout"},
        "originRef": {"$ref": "avo.timeline-common.schema.json#/$defs/importOriginRef"},
        "sourceAssemblyPolicy": {"$ref": "avo.timeline-common.schema.json#/$defs/sourceAssemblyPolicy"},
        "importOutput": {"$ref": "avo.timeline-common.schema.json#/$defs/importOutput"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawSource"
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "removals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "syncRef": {
          "oneOf": [{"$ref": "#/$defs/dependencyRef"}, {"allOf": [{"$ref": "https://avo.local/avo.timeline-revision.schema.json#/properties/basis/items"}, {"properties": {"artifactType": {"const": "sync-map"}}}]}]
        },
        "cuttingRef": {"$ref": "avo.cutting.schema.json#/$defs/artifactRef"},
        "protectionRef": {"$ref": "avo.cutting.schema.json#/$defs/artifactRef"},
        "protectedQuizWindows": {"type": "array", "items": {"type": "object"}},
        "generatedCut": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  }
}
