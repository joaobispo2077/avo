{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.proof-plan.v2.schema.json",
  "title": "AVO camera-aware immutable proof plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requiredReaderCapabilities",
    "proofPlanId",
    "iterationId",
    "canonicalInputLock",
    "regressionContract",
    "renderProfile",
    "output",
    "capabilityResolution",
    "implementationRefs",
    "videoGraph",
    "audioGraph",
    "events",
    "validationPlan",
    "visionReviewPlanRef",
    "lineagePolicy",
    "producer",
    "proofPlanHash"
  ],
  "properties": {
    "sourceAssemblyPolicy": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/sourceAssemblyPolicy"
    },
    "importOriginRef": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/importOriginRef"
    },
    "importOutput": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/importOutput"
    },
    "previewOnly": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/previewOnly"
    },
    "importApproximation": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/importApproximation"
    },
    "checkpoint": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/checkpoint"
    },
    "proofPlanId": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/proofPlanId"
    },
    "iterationId": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/iterationId"
    },
    "canonicalInputLock": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/canonicalInputLock"
    },
    "regressionContract": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/regressionContract"
    },
    "renderProfile": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/renderProfile"
    },
    "capabilityResolution": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/capabilityResolution"
    },
    "implementationRefs": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/implementationRefs"
    },
    "audioGraph": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/audioGraph"
    },
    "events": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/events"
    },
    "validationPlan": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/validationPlan"
    },
    "visionReviewPlanRef": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/visionReviewPlanRef"
    },
    "lineagePolicy": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/lineagePolicy"
    },
    "producer": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/producer"
    },
    "proofPlanHash": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/proofPlanHash"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "requiredReaderCapabilities": {
      "const": [
        "camera-transform-v1"
      ]
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "videoGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "anyOf": [
              {
              "allOf": [
                {"$ref": "https://avo.local/avo.proof-plan.schema.json#/$defs/operation"},
                {"properties": {"kind": {"not": {"const": "camera-transform"}}}}
              ]
              },
              {
                "$ref": "#/$defs/cameraOperation"
              }
            ]
          },
          "contains": {
            "properties": {
              "kind": {
                "const": "camera-transform"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/allOf/0"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "$ref": "https://avo.local/avo.proof-plan.schema.json#/$defs/sha256"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "center",
        "crop",
        "phase"
      ],
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "center": {
          "$ref": "https://avo.local/schemas/avo.camera-behavior.schema.json#/$defs/center"
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "phase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "cameraParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "cueId",
        "targetLayerId",
        "sourceId",
        "sourceOccurrenceId",
        "sourceSha256",
        "behavior",
        "geometry",
        "originalFrameRange",
        "entryState",
        "pathHash",
        "optionsHash"
      ],
      "properties": {
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "cueId": {
          "$ref": "#/$defs/id"
        },
        "targetLayerId": {
          "$ref": "#/$defs/id"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceOccurrenceId": {
          "$ref": "#/$defs/id"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha"
        },
        "behavior": {
          "$ref": "https://avo.local/schemas/avo.camera-behavior.schema.json#/$defs/behavior"
        },
        "geometry": {
          "$ref": "https://avo.local/schemas/avo.camera-behavior.schema.json#/$defs/geometry"
        },
        "originalFrameRange": {
          "$ref": "https://avo.local/schemas/avo.camera-behavior.schema.json#/$defs/frameRange"
        },
        "entryState": {
          "$ref": "#/$defs/state"
        },
        "pathHash": {
          "$ref": "#/$defs/sha"
        },
        "optionsHash": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "cameraOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "implementationId",
        "inputs",
        "outputRange",
        "parameters"
      ],
      "properties": {
        "operationId": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/$defs/stableId"
        },
        "kind": {
          "const": "camera-transform"
        },
        "implementationId": {
          "const": "impl-camera-transform"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "outputRange": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/$defs/frameRange"
        },
        "parameters": {
          "$ref": "#/$defs/cameraParameters"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "width",
        "height",
        "frameRate",
        "audioSampleRate",
        "channelLayout",
        "videoCodec",
        "audioCodec",
        "pixelFormat"
      ],
      "properties": {
        "path": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/path"
        },
        "width": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/width"
        },
        "height": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/height"
        },
        "frameRate": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/frameRate"
        },
        "audioSampleRate": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/audioSampleRate"
        },
        "channelLayout": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/channelLayout"
        },
        "videoCodec": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/videoCodec"
        },
        "audioCodec": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/audioCodec"
        },
        "expectedPrimingSamples": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/expectedPrimingSamples"
        },
        "expectedTailSamples": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/expectedTailSamples"
        },
        "conformance": {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/properties/conformance"
        },
        "pixelFormat": {
          "enum": [
            "yuv420p",
            "yuv420p10le",
            "yuv444p10le",
            "gbrp16le"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/allOf/0"
        },
        {
          "$ref": "https://avo.local/avo.proof-plan.schema.json#/properties/output/allOf/1"
        }
      ]
    }
  }
}
