{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.review-batch.schema.json",
  "title": "AVO native review batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": { "enum": ["cut-proof", "motion-proof", "pre-master", "deliver"] },
        "profile": { "type": "string", "minLength": 1 }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "candidate", "sha256", "bytes", "risk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "candidate": { "type": "string", "minLength": 1 },
          "checkpoint": { "enum": ["cut-proof", "motion-proof", "pre-master", "deliver"] },
          "profile": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "windows": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9.]+:[0-9.]+:.+$" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start", "end", "reason"],
                  "properties": {
                    "start": { "type": "number", "minimum": 0 },
                    "end": { "type": "number", "exclusiveMinimum": 0 },
                    "reason": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          },
          "terms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "names": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
