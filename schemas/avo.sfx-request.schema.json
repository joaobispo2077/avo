{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/schemas/avo.sfx-request.schema.json",
  "title": "Explicit sound catalogue request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "operation", "operationId"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "operation": {"enum": ["scan", "annotate", "search", "search-semantic"]},
    "operationId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "actor": {"$ref": "avo.sfx-catalog.schema.json#/$defs/text"},
    "reason": {"$ref": "avo.sfx-catalog.schema.json#/$defs/text"},
    "expectedGeneration": {"$ref": "avo.sfx-catalog.schema.json#/$defs/nullableSha"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["entryId"], "properties": {"entryId": {"$ref": "avo.sfx-catalog.schema.json#/$defs/sha"}}},
    "patch": {"$ref": "avo.sfx-catalog.schema.json#/$defs/annotationPatch"},
    "budget": {"type": "object", "additionalProperties": false, "properties": {
      "maxFiles": {"type": "integer", "minimum": 1, "maximum": 10000},
      "maxBytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
      "maxSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
    }},
    "resume": {"$ref": "avo.sfx-catalog.schema.json#/properties/resume"},
    "useProviderFavorites": {"type": "boolean"},
    "query": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "filters": {"$ref": "avo.sfx-search.schema.json#/$defs/filters"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 8192},
    "generation": {"$ref": "avo.sfx-catalog.schema.json#/$defs/sha"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "scan"}}}, "then": {
      "required": ["actor", "reason", "expectedGeneration"],
      "propertyNames": {"enum": ["contractVersion", "operation", "operationId", "actor", "reason", "expectedGeneration", "budget", "resume", "useProviderFavorites"]}
    }},
    {"if": {"properties": {"operation": {"const": "annotate"}}}, "then": {
      "required": ["actor", "reason", "expectedGeneration", "selection", "patch"],
      "propertyNames": {"enum": ["contractVersion", "operation", "operationId", "actor", "reason", "expectedGeneration", "selection", "patch"]}
    }},
    {"if": {"properties": {"operation": {"enum": ["search", "search-semantic"]}}}, "then": {
      "required": ["query"],
      "propertyNames": {"enum": ["contractVersion", "operation", "operationId", "query", "filters", "limit", "cursor", "generation"]}
    }}
  ]
}
