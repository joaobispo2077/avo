{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.still-extraction.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "extractionId", "purpose", "inputKind", "inputFingerprint", "canonicalMapping", "requestedTime", "resolvedFrame", "output", "media", "colorPolicy", "approvalState", "createdAt", "recordHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "extractionId": { "$ref": "#/$defs/stableId" }, "purpose": { "enum": ["thumbnail", "review", "reference", "canonical-generated-asset"] }, "inputKind": { "enum": ["raw-source", "program", "current-candidate", "approved-candidate"] }, "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
    "canonicalMapping": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["sourceId", "sourceFrame", "programFrame"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "sourceFrame": { "type": "integer", "minimum": 0 }, "programFrame": { "type": "integer", "minimum": 0 } } }, { "type": "null" }] },
    "requestedTime": { "type": "object", "additionalProperties": false, "required": ["kind", "boundarySide"], "properties": { "kind": { "enum": ["source-time", "program-frame", "candidate-frame"] }, "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 1 }, "frame": { "type": "integer", "minimum": 0 }, "boundarySide": { "enum": ["incoming", "outgoing", "not-boundary"] } }, "allOf": [{ "if": { "properties": { "kind": { "const": "source-time" } } }, "then": { "required": ["numerator", "denominator"] }, "else": { "required": ["frame"] } }] },
    "resolvedFrame": { "type": "object", "additionalProperties": false, "required": ["streamTimebase", "originalPts", "normalizedPts", "nextPts", "displayDuration", "decodedFrameIndex", "cfrFrameRate", "selectionMethod", "boundaryDecision"], "properties": { "streamTimebase": { "$ref": "#/$defs/rational" }, "originalPts": { "type": "integer" }, "normalizedPts": { "type": "integer", "minimum": 0 }, "nextPts": { "type": "integer", "minimum": 1 }, "displayDuration": { "type": "integer", "minimum": 1 }, "decodedFrameIndex": { "type": "integer", "minimum": 0 }, "cfrFrameRate": { "oneOf": [{ "$ref": "#/$defs/rational" }, { "type": "null" }] }, "selectionMethod": { "enum": ["pts-interval", "decoded-frame-index", "cfr-frame-map"] }, "boundaryDecision": { "enum": ["incoming", "outgoing", "not-boundary"] } } },
    "output": { "$ref": "#/$defs/fingerprint" },
    "media": { "type": "object", "additionalProperties": false, "required": ["encodedWidth", "encodedHeight", "displayWidth", "displayHeight", "pixelFormat", "rotationDegrees", "sampleAspectRatio", "colorPrimaries", "transfer", "matrix", "range", "hdrState"], "properties": { "encodedWidth": { "type": "integer", "minimum": 1 }, "encodedHeight": { "type": "integer", "minimum": 1 }, "displayWidth": { "type": "integer", "minimum": 1 }, "displayHeight": { "type": "integer", "minimum": 1 }, "pixelFormat": { "type": "string", "minLength": 1 }, "rotationDegrees": { "type": "number" }, "sampleAspectRatio": { "$ref": "#/$defs/rational" }, "colorPrimaries": { "type": "string", "minLength": 1 }, "transfer": { "type": "string", "minLength": 1 }, "matrix": { "type": "string", "minLength": 1 }, "range": { "enum": ["full", "limited", "unknown"] }, "hdrState": { "enum": ["sdr", "hdr-preserved", "hdr-tone-mapped"] } } },
    "colorPolicy": { "type": "object", "additionalProperties": false, "required": ["policyId", "version", "conversionParameters", "tool"], "properties": { "policyId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "conversionParameters": { "type": "object", "additionalProperties": true }, "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } } } },
    "approvalState": { "enum": ["candidate", "approved", "rejected", "superseded"] }, "createdAt": { "type": "string", "minLength": 1 }, "recordHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "inputKind": { "const": "current-candidate" } } }, "then": { "properties": { "purpose": { "enum": ["review", "reference"] } } } },
    { "if": { "properties": { "purpose": { "const": "thumbnail" } } }, "then": { "properties": { "inputKind": { "enum": ["raw-source", "program", "approved-candidate"] } } } }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }, "rational": { "type": "object", "additionalProperties": false, "required": ["num", "den"], "properties": { "num": { "type": "integer" }, "den": { "type": "integer", "minimum": 1 } } }, "fingerprint": { "type": "object", "additionalProperties": false, "required": ["sha256", "sizeBytes"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "locator": { "type": "string", "minLength": 1 }, "mediaSignature": { "type": "object", "additionalProperties": true } } } }
}
