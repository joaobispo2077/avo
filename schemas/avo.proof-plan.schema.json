{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.proof-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proofPlanId", "iterationId", "canonicalInputLock", "regressionContract", "renderProfile", "output", "capabilityResolution", "implementationRefs", "videoGraph", "audioGraph", "events", "validationPlan", "visionReviewPlanRef", "lineagePolicy", "producer", "proofPlanHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "proofPlanId": { "$ref": "#/$defs/stableId" }, "iterationId": { "$ref": "#/$defs/stableId" },
    "canonicalInputLock": { "type": "object", "minProperties": 5, "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "regressionContract": { "type": "object", "additionalProperties": false, "required": ["contractId", "ledgerHash", "iterationId", "obligations", "historicalRiskWindows", "conflicts", "contractHash"], "properties": { "contractId": { "$ref": "#/$defs/stableId" }, "ledgerHash": { "$ref": "#/$defs/sha256" }, "iterationId": { "$ref": "#/$defs/stableId" }, "obligations": { "type": "array", "items": { "type": "object" } }, "historicalRiskWindows": { "type": "array", "items": { "$ref": "#/$defs/frameRange" } }, "conflicts": { "type": "array", "items": { "type": "object" } }, "contractHash": { "$ref": "#/$defs/sha256" } } },
    "renderProfile": { "type": "string", "minLength": 1 },
    "output": { "$ref": "#/$defs/output" },
    "capabilityResolution": { "type": "array", "items": { "$ref": "#/$defs/capabilityResolution" } },
    "implementationRefs": { "type": "array", "items": { "$ref": "#/$defs/implementationRef" } },
    "videoGraph": { "$ref": "#/$defs/operationGraph" }, "audioGraph": { "$ref": "#/$defs/audioGraph" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/timedEvent" } },
    "validationPlan": { "type": "object", "additionalProperties": false, "required": ["preflight", "microproof", "fullReview", "historicalRegression"], "properties": { "preflight": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "microproof": { "type": "array", "items": { "$ref": "#/$defs/frameRange" } }, "fullReview": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "historicalRegression": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "visionReviewPlanRef": { "oneOf": [{ "$ref": "#/$defs/hashRef" }, { "type": "null" }] },
    "lineagePolicy": { "type": "object", "additionalProperties": false, "required": ["allowedMediaClasses", "prohibitedMediaClasses", "recursive"], "properties": { "allowedMediaClasses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "prohibitedMediaClasses": { "type": "array", "items": { "enum": ["proof", "preview", "proxy", "master", "delivery"] }, "uniqueItems": true }, "recursive": { "const": true } } },
    "producer": { "type": "object", "additionalProperties": false, "required": ["name", "version", "compiler"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "compiler": { "type": "string", "minLength": 1 } } },
    "proofPlanHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "hashRef": { "type": "object", "additionalProperties": false, "required": ["artifactId", "sha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "frameRate": { "type": "object", "additionalProperties": false, "required": ["num", "den"], "properties": { "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } } },
    "frameRange": { "type": "object", "additionalProperties": false, "required": ["startFrame", "endFrameExclusive"], "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrameExclusive": { "type": "integer", "minimum": 1 } } },
    "sampleRange": { "type": "object", "additionalProperties": false, "required": ["startSample", "endSampleExclusive"], "properties": { "startSample": { "type": "integer", "minimum": 0 }, "endSampleExclusive": { "type": "integer", "minimum": 1 } } },
    "output": { "type": "object", "additionalProperties": false, "required": ["path", "width", "height", "frameRate", "audioSampleRate", "channelLayout", "videoCodec", "audioCodec"], "properties": { "path": { "type": "string", "minLength": 1 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "frameRate": { "$ref": "#/$defs/frameRate" }, "audioSampleRate": { "type": "integer", "minimum": 1 }, "channelLayout": { "type": "string", "minLength": 1 }, "videoCodec": { "type": "string", "minLength": 1 }, "audioCodec": { "type": "string", "minLength": 1 }, "expectedPrimingSamples": { "type": "integer", "minimum": 0 }, "expectedTailSamples": { "type": "integer", "minimum": 0 } } },
    "implementationRef": { "type": "object", "additionalProperties": false, "required": ["implementationId", "kind", "adapterId", "version", "sha256"], "properties": { "implementationId": { "$ref": "#/$defs/stableId" }, "kind": { "enum": ["built-in", "provider-component", "project-component", "custom-project"] }, "adapterId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "componentInstanceId": { "$ref": "#/$defs/stableId" }, "generatedAssetId": { "$ref": "#/$defs/stableId" } } },
    "capabilityResolution": { "type": "object", "additionalProperties": false, "required": ["operationId", "capability", "implementationId", "status"], "properties": { "operationId": { "$ref": "#/$defs/stableId" }, "capability": { "type": "string", "minLength": 1 }, "implementationId": { "$ref": "#/$defs/stableId" }, "status": { "enum": ["resolved", "unsupported", "blocked"] } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["operationId", "kind", "inputs", "outputRange", "implementationId", "parameters"], "properties": { "operationId": { "$ref": "#/$defs/stableId" }, "kind": { "type": "string", "minLength": 1 }, "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "outputRange": { "$ref": "#/$defs/frameRange" }, "implementationId": { "$ref": "#/$defs/stableId" }, "parameters": { "type": "object", "additionalProperties": true } } },
    "operationGraph": { "type": "object", "additionalProperties": false, "required": ["operations"], "properties": { "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } } } },
    "audioNode": { "type": "object", "additionalProperties": false, "required": ["nodeId", "kind", "sourceSampleRate", "targetSampleRate", "sourceRange", "outputRange", "sourceLayout", "targetLayout", "channelMap", "latencyCompensationSamples"], "properties": { "nodeId": { "$ref": "#/$defs/stableId" }, "kind": { "enum": ["source", "silence", "music", "sfx", "ambience", "mix", "crossfade", "output"] }, "sourceSampleRate": { "type": "integer", "minimum": 1 }, "targetSampleRate": { "type": "integer", "minimum": 1 }, "sourceRange": { "$ref": "#/$defs/sampleRange" }, "outputRange": { "$ref": "#/$defs/sampleRange" }, "sourceLayout": { "type": "string", "minLength": 1 }, "targetLayout": { "type": "string", "minLength": 1 }, "channelMap": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "latencyCompensationSamples": { "type": "integer" } } },
    "audioGraph": { "type": "object", "additionalProperties": false, "required": ["sampleRate", "nodes", "operations", "singleFinalEncode"], "properties": { "sampleRate": { "type": "integer", "minimum": 1 }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/audioNode" } }, "operations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["operationId", "kind", "range", "parameters"], "properties": { "operationId": { "$ref": "#/$defs/stableId" }, "kind": { "enum": ["trim", "mix", "crossfade", "gain", "fade", "duck", "filter", "resample", "encode"] }, "range": { "$ref": "#/$defs/sampleRange" }, "parameters": { "type": "object", "additionalProperties": true } } } }, "singleFinalEncode": { "const": true } } },
    "timedEvent": { "type": "object", "additionalProperties": false, "required": ["eventId", "role", "programFrame", "visibleRange", "sourceRange", "audio", "transientOffset", "resolvedImpactSample", "entryEffectIds", "validation"], "properties": { "eventId": { "$ref": "#/$defs/stableId" }, "role": { "enum": ["main-scene", "overlay-image", "overlay-video", "authored-graphic", "caption", "source-audio", "music", "sfx", "ambience", "comparison-only"] }, "programFrame": { "type": "integer", "minimum": 0 }, "visibleRange": { "oneOf": [{ "$ref": "#/$defs/frameRange" }, { "type": "null" }] }, "sourceRange": { "type": ["object", "null"] }, "audio": { "type": ["object", "null"] }, "transientOffset": { "type": ["object", "null"] }, "resolvedImpactSample": { "type": "integer", "minimum": 0 }, "entryEffectIds": { "type": "array", "items": { "$ref": "#/$defs/stableId" } }, "validation": { "type": "object", "minProperties": 1, "additionalProperties": true } } }
  }
}
