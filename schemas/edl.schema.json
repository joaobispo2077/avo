{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/schemas/edl.schema.json",
  "title": "AVO Edit Decision List",
  "type": "object",
  "required": ["version", "story_map_approval", "sources", "ranges"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "feature_id": {
      "type": "string"
    },
    "story_map_approval": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "start", "end"],
        "properties": {
          "source": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "story_section_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "grade": {
      "type": ["string", "null"]
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sound_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "subtitles": {
      "type": ["string", "null"]
    },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "program_mode": {
          "type": "string",
          "enum": ["camera", "external_voiceover"]
        },
        "voiceover_source": { "type": "string" },
        "noise_reduction_policy": { "type": "string" },
        "restoration_default_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "restoration_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_in_source", "end_in_source", "strength_pct"],
            "properties": {
              "start_in_source": { "type": "number" },
              "end_in_source": { "type": "number" },
              "strength_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
              "reason": { "type": "string" },
              "approved_by_user": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "gain_policy": { "type": "string" },
        "gain_default_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "gain_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_in_source", "end_in_source", "boost_pct"],
            "properties": {
              "start_in_source": { "type": "number" },
              "end_in_source": { "type": "number" },
              "boost_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
              "reason": { "type": "string" },
              "approved_by_user": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "caption_burn_in": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "caption_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "motion_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "render_gate": {
      "type": "object",
      "additionalProperties": true
    },
    "review_package": {
      "type": "object",
      "additionalProperties": true
    },
    "blocked_source_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "ad_segment": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
