{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.editing-craft-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "requestId", "selection", "directionRef", "basisHeads", "actor", "reason"],
  "properties": {
    "runId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "selection": {"$ref": "avo.editing-craft.schema.json#/$defs/selection"},
    "directionRef": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 4096},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "basisHeads": {
      "type": "object", "additionalProperties": false,
      "required": ["cmap", "bmap", "tracks", "animation", "sync-map"],
      "properties": {
        "cmap": {"$ref": "#/$defs/head"}, "bmap": {"$ref": "#/$defs/head"},
        "tracks": {"$ref": "#/$defs/head"}, "animation": {"$ref": "#/$defs/head"},
        "sync-map": {"$ref": "#/$defs/head"}
      }
    },
    "actor": {"type": "string", "pattern": "\\S", "maxLength": 512},
    "reason": {"type": "string", "pattern": "\\S", "maxLength": 4096}
  },
  "$defs": {
    "workReference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "operationId", "requestId", "proposalRef", "scope"],
      "properties": {
        "kind": {"enum": ["motion", "sound"]},
        "operationId": {"type": "string", "pattern": "\\S", "maxLength": 128},
        "requestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "proposalRef": {"$ref": "avo.motion-proposal.schema.json#/$defs/ref"},
        "scope": {"$ref": "#/$defs/workScope"}
      }
    },
    "workScope": {
      "type": "object", "additionalProperties": false,
      "required": ["itemIds", "eventIds"],
      "properties": {
        "itemIds": {"$ref": "#/$defs/workIds"},
        "eventIds": {"$ref": "#/$defs/workIds"}
      }
    },
    "workIds": {
      "type": "array", "maxItems": 500, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S", "maxLength": 128}
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "head": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["revisionId", "sha256"],
          "properties": {
            "revisionId": {"type": "string", "minLength": 1, "maxLength": 128},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
