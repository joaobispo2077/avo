{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/contracts/shorts-composition.schema.json",
  "title": "AVO Shorts Composition Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "batchId",
    "shortId",
    "proofRevision",
    "width",
    "height",
    "fps",
    "durationSec",
    "assets",
    "layout",
    "captions",
    "providerTokens",
    "templateVersion",
    "expectedOutputPath"
  ],
  "properties": {
    "version": {
      "enum": ["1.0", "1.1", "1.2"]
    },
    "planVersion": { "enum": ["1.0", "1.1", "1.2"] },
    "sourceSegments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "preparedLineage": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "requiredWatchWindows": {
      "type": "array",
      "items": { "type": "object" }
    },
    "batchId": {
      "type": "string"
    },
    "shortId": {
      "type": "string"
    },
    "proofRevision": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "durationSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseVideo",
        "dialogueAudio"
      ],
      "properties": {
        "baseVideo": {
          "$ref": "#/$defs/asset"
        },
        "dialogueAudio": {
          "$ref": "#/$defs/asset"
        },
        "insertionVideo": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "insertionAudio": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "sfxChip": { "$ref": "#/$defs/asset" },
        "sfxStamp": { "$ref": "#/$defs/asset" },
        "sfxPunch": { "$ref": "#/$defs/asset" },
        "sfxSeam": { "$ref": "#/$defs/asset" },
        "sfxPrice": { "$ref": "#/$defs/asset" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "captionAnchor",
        "baseRegion"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full-frame",
            "split"
          ]
        },
        "captionAnchor": {
          "enum": [
            "top",
            "bottom",
            "center",
            "seam"
          ]
        },
        "baseRegion": {
          "$ref": "#/$defs/rect"
        },
        "insertionRegion": {
          "anyOf": [
            {
              "$ref": "#/$defs/rect"
            },
            {
              "type": "null"
            }
          ]
        },
        "paneOrder": {
          "enum": [
            "base-first",
            "insertion-first"
          ]
        },
        "focusPoint": {
          "$ref": "#/$defs/point"
        },
        "safeMargins": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "callouts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "startSec", "endSec", "corner"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["chip", "stamp"] },
          "text": { "type": "string", "minLength": 1 },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "exclusiveMinimum": 0 },
          "corner": { "enum": ["bl", "br", "bc"] }
        }
      }
    },
    "punchIns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startSec", "endSec"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "exclusiveMinimum": 0 },
          "scale": { "type": "number", "minimum": 1, "maximum": 1.2 }
        }
      }
    },
    "graphics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "widget", "startSec", "endSec", "corner"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "widget": {
            "enum": [
              "stars",
              "stack-resolve",
              "vs-reject",
              "flip-180",
              "cover-wipe",
              "ratio-lock",
              "duration-meter",
              "two-roles",
              "badge-pair",
              "price-duel"
            ]
          },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "exclusiveMinimum": 0 },
          "corner": { "enum": ["bl", "br", "bc"] },
          "params": { "type": "object", "minProperties": 1 },
          "sfx": {
            "anyOf": [
              { "$ref": "#/$defs/graphicSfx" },
              {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/graphicSfx" }
              }
            ]
          }
        }
      }
    },
    "sfxHits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "startSec"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["chip", "stamp", "punch", "seam", "price"] },
          "startSec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "providerTokens": {
      "type": "object",
      "additionalProperties": true
    },
    "templateVersion": {
      "type": "string"
    },
    "expectedTimelineCount": {
      "const": 1
    },
    "expectedOutputPath": {
      "type": "string"
    },
    "provenanceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": "1.0" } }, "required": ["version"] },
      "then": {
        "properties": {
          "assets": {
            "allOf": [
              { "not": { "required": ["sfxChip"] } },
              { "not": { "required": ["sfxStamp"] } },
              { "not": { "required": ["sfxPunch"] } },
              { "not": { "required": ["sfxSeam"] } },
              { "not": { "required": ["sfxPrice"] } }
            ]
          }
        },
        "allOf": [
          { "not": { "required": ["planVersion"] } },
          { "not": { "required": ["sourceSegments"] } },
          { "not": { "required": ["preparedLineage"] } },
          { "not": { "required": ["requiredWatchWindows"] } },
          { "not": { "required": ["callouts"] } },
          { "not": { "required": ["punchIns"] } },
          { "not": { "required": ["graphics"] } },
          { "not": { "required": ["sfxHits"] } }
        ]
      }
    },
    {
      "if": { "properties": { "version": { "const": "1.1" } }, "required": ["version"] },
      "then": {
        "required": ["planVersion", "sourceSegments", "preparedLineage"],
        "properties": {
          "assets": {
            "allOf": [
              { "not": { "required": ["sfxChip"] } },
              { "not": { "required": ["sfxStamp"] } },
              { "not": { "required": ["sfxPunch"] } },
              { "not": { "required": ["sfxSeam"] } },
              { "not": { "required": ["sfxPrice"] } }
            ]
          }
        },
        "allOf": [
          { "not": { "required": ["callouts"] } },
          { "not": { "required": ["punchIns"] } },
          { "not": { "required": ["graphics"] } },
          { "not": { "required": ["sfxHits"] } }
        ]
      }
    },
    {
      "if": {
        "properties": { "version": { "const": "1.2" } },
        "required": ["version"],
        "anyOf": [
          { "required": ["planVersion"] },
          { "required": ["sourceSegments"] },
          { "required": ["preparedLineage"] },
          { "required": ["requiredWatchWindows"] }
        ]
      },
      "then": { "required": ["planVersion", "sourceSegments", "preparedLineage"] }
    }
  ],
  "$defs": {
    "graphicSfx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["chip", "stamp", "punch", "seam", "price"] },
        "every": {
          "enum": [
            "start",
            "fill",
            "item",
            "resolve",
            "reject",
            "confirm",
            "badge",
            "role",
            "downbeat",
            "wipe"
          ]
        },
        "offsetSec": { "type": "number" },
        "atSec": { "type": "number", "minimum": 0 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "durationSec"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "muted": {
          "type": "boolean"
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
