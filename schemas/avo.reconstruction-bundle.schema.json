{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.reconstruction-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "videoId",
    "createdAt",
    "master",
    "finalTranscript",
    "rawSources",
    "canonicalArtifacts",
    "reviewEvidence",
    "files",
    "bundleSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "videoId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "master": {
      "$ref": "#/$defs/file"
    },
    "finalTranscript": {
      "$ref": "#/$defs/file"
    },
    "rawSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "canonicalArtifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "reviewEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "bundleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string"
        }
      }
    }
  }
}
