{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/contracts/shorts-batch-plan.schema.json",
  "title": "AVO Resolved Shorts Batch Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "batchId",
    "planRevision",
    "requestPath",
    "requestHash",
    "requestedCount",
    "resolvedCount",
    "output",
    "items",
    "insertionAllocation",
    "planApproval",
    "planHash"
  ],
  "properties": {
    "version": {
      "enum": ["1.0", "1.1", "1.2"]
    },
    "planVersion": { "enum": ["1.0", "1.1", "1.2"] },
    "batchRoot": { "type": "string", "minLength": 1 },
    "batchRootSource": { "enum": ["canonical-default", "invocation", "legacy-output"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "masterPath", "mediaFingerprint"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "masterPath": { "type": "string", "minLength": 1 },
        "transcriptPath": { "type": ["string", "null"] },
        "mediaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "transcriptFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "batchId": {
      "type": "string"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 1
    },
    "requestPath": {
      "type": "string"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "providerTokensFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "providerTokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestedCount": {
      "type": "integer",
      "minimum": 1
    },
    "resolvedCount": {
      "type": "integer",
      "minimum": 1
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "previewLongSide": {
          "type": "integer",
          "minimum": 2,
          "default": 640
        },
        "pixelFormat": {
          "enum": [
            "yuv420p",
            "yuv420p10le"
          ],
          "default": "yuv420p"
        },
        "frameRateRational": {
          "type": "string",
          "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
        },
        "colorSpace": {
          "const": "bt709"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "insertionAllocation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "insertionId"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "insertionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredHumanReviews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSec",
        "endSec"
      ],
      "properties": {
        "startSec": {
          "type": "number",
          "minimum": 0
        },
        "endSec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "startSec",
        "endSec",
        "punch",
        "highlightEnterSec",
        "highlightExitSec"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "startSec": {
          "type": "number",
          "minimum": 0
        },
        "endSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "punch": {
          "type": "boolean"
        },
        "highlightEnterSec": {
          "type": "number",
          "minimum": 0
        },
        "highlightExitSec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startSec",
        "endSec",
        "renderedText",
        "words"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startSec": {
          "type": "number",
          "minimum": 0
        },
        "endSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "renderedText": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "autofixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "startSec", "endSec", "corner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "kind": { "enum": ["chip", "stamp"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "corner": { "enum": ["bl", "br", "bc"] }
      }
    },
    "punchIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startSec", "endSec"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "minimum": 1, "maximum": 1.2 }
      }
    },
    "graphicSfx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["chip", "stamp", "punch", "seam", "price"] },
        "every": {
          "enum": [
            "start",
            "fill",
            "item",
            "resolve",
            "reject",
            "confirm",
            "badge",
            "role",
            "downbeat",
            "wipe"
          ]
        },
        "offsetSec": { "type": "number" },
        "atSec": { "type": "number", "minimum": 0 }
      }
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "widget", "startSec", "endSec", "corner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "widget": {
          "enum": [
            "stars",
            "stack-resolve",
            "vs-reject",
            "flip-180",
            "cover-wipe",
            "ratio-lock",
            "duration-meter",
            "two-roles",
            "badge-pair",
            "price-duel"
          ]
        },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "corner": { "enum": ["bl", "br", "bc"] },
        "params": {
          "type": "object",
          "minProperties": 1
        },
        "sfx": {
          "anyOf": [
            { "$ref": "#/$defs/graphicSfx" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/graphicSfx" }
            }
          ]
        }
      }
    },
    "sfxHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "startSec"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "kind": { "enum": ["chip", "stamp", "punch", "seam", "price"] },
        "startSec": { "type": "number", "minimum": 0 }
      }
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputStartSec",
        "outputEndSec",
        "sourceStartSec",
        "sourceEndSec"
      ],
      "properties": {
        "outputStartSec": {
          "type": "number",
          "minimum": 0
        },
        "outputEndSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceStartSec": {
          "type": "number",
          "minimum": 0
        },
        "sourceEndSec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "resolvedSourceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmentId", "order", "sourceId", "startSec", "endSec", "rationale", "evidenceReference", "sourceFingerprint", "outputStartSec", "outputEndSec"],
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceReference": { "type": "string", "minLength": 1 },
        "overlapApprovalReference": { "type": ["string", "null"], "minLength": 1 },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputStartSec": { "type": "number", "minimum": 0 },
        "outputEndSec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "coreIdea",
        "viewerPromise",
        "postingTitle",
        "sourceEvidence",
        "speed",
        "editedDurationSec",
        "layout",
        "captions",
        "inputFingerprint",
        "expectedOutputBasename",
        "qcProfile"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "coreIdea": {
          "type": "string"
        },
        "viewerPromise": {
          "type": "string"
        },
        "postingTitle": {
          "type": "string"
        },
        "sourceRange": {
          "$ref": "#/$defs/range"
        },
        "sourceSegments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolvedSourceSegment" }
        },
        "sourceEvidence": {
          "type": "string"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "editedDurationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layout": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "callouts": {
          "type": "array",
          "items": { "$ref": "#/$defs/callout" }
        },
        "punchIns": {
          "type": "array",
          "items": { "$ref": "#/$defs/punchIn" }
        },
        "graphics": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphic" }
        },
        "sfxHits": {
          "type": "array",
          "items": { "$ref": "#/$defs/sfxHit" }
        },
        "captionCorrectionAudit": {
          "type": "array",
          "items": { "type": "object" }
        },
        "insertion": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "videoStreamIndex": {
              "type": "string"
            },
            "audioStreamIndex": {
              "type": [
                "string",
                "null"
              ]
            },
            "targetDurationSec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "supportVolume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sourceTimeMap": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sourceMap"
              }
            },
            "rightsReference": {
              "type": "string"
            }
          }
        },
        "compositionSpecPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "compositionSpecHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedOutputBasename": {
          "type": "string"
        },
        "rightsReviewReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "factualReviewReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qcProfile": {
          "type": "string"
        },
        "visualInserts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualInsert"
          }
        },
        "audioTreatment": {
          "$ref": "#/$defs/audioTreatment"
        },
        "audioBed": {
          "$ref": "#/$defs/resolvedAudioBed"
        }
      }
    },
    "visualInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "rightsReference",
        "startSec",
        "endSec",
        "rect",
        "fit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ancestry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mediaClass",
              "locator",
              "sha256"
            ],
            "properties": {
              "mediaClass": {
                "const": "source"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "rightsReference": {
          "type": "string",
          "minLength": 1
        },
        "startSec": {
          "type": "number",
          "minimum": 0
        },
        "endSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "baseRegion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceStartSec": {
          "type": "number",
          "minimum": 0
        },
        "sourceEndSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "videoStreamIndex": {
          "const": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            }
          },
          "then": {
            "required": [
              "sourceStartSec",
              "sourceEndSec",
              "videoStreamIndex"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceStartSec"
                  ]
                },
                {
                  "required": [
                    "sourceEndSec"
                  ]
                },
                {
                  "required": [
                    "videoStreamIndex"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "audioTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "channel",
        "eqProfile",
        "noiseReduction",
        "approval"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^0:a:[0-9]+$"
        },
        "channel": {
          "enum": [
            "mono",
            "stereo"
          ]
        },
        "eqProfile": {
          "enum": [
            "dialogue-v1",
            "bishop-dialogue-v1"
          ]
        },
        "noiseReduction": {
          "type": "object",
          "additionalProperties": true
        },
        "protectedWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startSec",
              "endSec",
              "reason"
            ],
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "resolvedAudioBed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "fingerprint",
        "authorizedWindow",
        "origin",
        "rights",
        "timelineStartSec",
        "sourceStartSec",
        "durationSec",
        "fadeInMs",
        "fadeOutMs",
        "ducking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorizedWindow": {
          "type": "object",
          "additionalProperties": true
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "object",
          "additionalProperties": true
        },
        "timelineStartSec": {
          "type": "number",
          "minimum": 0
        },
        "sourceStartSec": {
          "type": "number",
          "minimum": 0
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fadeInMs": {
          "type": "integer",
          "minimum": 0
        },
        "fadeOutMs": {
          "type": "integer",
          "minimum": 0
        },
        "ducking": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "sourceRange"
              ],
              "allOf": [
                {
                  "not": {
                    "required": [
                      "sourceSegments"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "callouts"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "punchIns"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "graphics"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "sfxHits"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "audioTreatment"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "audioBed"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "required": [
          "planVersion",
          "batchRoot",
          "batchRootSource",
          "source"
        ],
        "properties": {
          "items": {
            "items": {
              "required": [
                "sourceSegments"
              ],
              "allOf": [
                {
                  "not": {
                    "required": [
                      "sourceRange"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "callouts"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "punchIns"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "graphics"
                    ]
                  }
                },
                {
                  "not": {
