{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.code-drawn.schema.json",
  "title": "Code-drawn composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compositionId",
    "engine",
    "drawingRoute",
    "entry",
    "sourceRevision",
    "files",
    "assets",
    "dependencies",
    "seed",
    "renderContract",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "compositionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "engine": {
      "const": "code-drawn"
    },
    "drawingRoute": {
      "enum": [
        "canvas",
        "svg",
        "brush"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "source",
              "script",
              "style",
              "data"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "id",
          "kind",
          "rightsRef"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "font",
              "image",
              "svg",
              "data"
            ]
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": [
              "integer",
              "string"
            ]
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceId"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetId",
                  "recordHash"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{2,63}$"
                  },
                  "recordHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "font"
                }
              }
            },
            "then": {
              "required": [
                "family",
                "style",
                "weight"
              ]
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "name",
          "version",
          "build",
          "licenseRef"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "build": {
            "type": "string",
            "minLength": 1
          },
          "licenseRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "renderContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frameRate",
        "frameCount",
        "background",
        "alphaMode",
        "captureColorSpace",
        "compositeColorSpace",
        "quality"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num",
            "den"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "color"
              ],
              "properties": {
                "mode": {
                  "const": "opaque"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}([a-fA-F0-9]{2})?$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "transparent"
                }
              }
            }
          ]
        },
        "alphaMode": {
          "enum": [
            "opaque",
            "straight"
          ]
        },
        "captureColorSpace": {
          "const": "srgb"
        },
        "compositeColorSpace": {
          "const": "sdr-bt709"
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spatialSamples",
            "temporalSamples"
          ],
          "properties": {
            "spatialSamples": {
              "const": 1
            },
            "temporalSamples": {
              "const": 1
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shortsCaptionPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "bindingMode",
        "instanceId",
        "manifestRef",
        "renderContractHash",
        "inputsHash",
        "inputs",
        "generator",
        "environment",
        "inputLockHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "bindingMode": {
          "enum": [
            "standalone",
            "canonical"
          ]
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "manifestRef": {
          "$ref": "#/$defs/fileRef"
        },
        "renderContractHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "fingerprint",
              "ancestryRole"
            ],
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locator",
                  "sha256",
                  "sizeBytes"
                ],
                "properties": {
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "ancestryRole": {
                "enum": [
                  "source",
                  "generated",
                  "dependency"
                ]
              }
            }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapterId",
            "version",
            "executableSha256",
            "sourceSha256"
          ],
          "properties": {
            "adapterId": {
              "const": "code-drawn"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "executableSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "dependencies"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "seed": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "browserVersion": {
              "type": "string",
              "minLength": 1
            },
            "browserRevision": {
              "type": "string",
              "minLength": 1
            },
            "graphics": {
              "type": "string",
              "minLength": 1
            },
            "driverSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoderSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "locale": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "colorSpace": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inputLockHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonicalInputLock": {
          "type": "object",
          "required": [
            "cmap",
            "bmap",
            "tracks",
            "animation",
            "sync-map"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startFrame",
            "endFrameExclusive"
          ],
          "properties": {
            "startFrame": {
              "type": "integer",
              "minimum": 0
            },
            "endFrameExclusive": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height",
            "zOrder",
            "layerRole"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "zOrder": {
              "type": "integer"
            },
            "layerRole": {
              "enum": [
                "base",
                "overlay",
                "caption",
                "graphic"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bindingMode": {
                "const": "canonical"
              }
            }
          },
          "then": {
            "required": [
              "canonicalInputLock",
              "range",
              "placement"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "canonicalInputLock"
                  ]
                },
                {
                  "required": [
                    "range"
                  ]
                },
                {
                  "required": [
                    "placement"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "renderContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frameRate",
        "frameCount",
        "background",
        "alphaMode",
        "captureColorSpace",
        "compositeColorSpace",
        "quality"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num",
            "den"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "color"
              ],
              "properties": {
                "mode": {
                  "const": "opaque"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}([a-fA-F0-9]{2})?$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "transparent"
                }
              }
            }
          ]
        },
        "alphaMode": {
          "enum": [
            "opaque",
            "straight"
          ]
        },
        "captureColorSpace": {
          "const": "srgb"
        },
        "compositeColorSpace": {
          "const": "sdr-bt709"
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spatialSamples",
            "temporalSamples"
          ],
          "properties": {
            "spatialSamples": {
              "const": 1
            },
            "temporalSamples": {
              "const": 1
            }
          }
        }
      }
    }
  }
}
