                "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/sourceMixAdjustment"
              },
              "description": "Post-cut gain adjustments to existing imported CMap audio placements; never additional audio sources."
            }
          }
        },
        "videoTracks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layers"
          ],
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "layerId",
                  "order",
                  "role",
                  "regions",
                  "zOrder"
                ],
                "properties": {
                  "layerId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{2,63}$"
