                          "properties": {
                            "adapterId": {
                              "const": "code-drawn"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "cmapBasis": {
          "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/dependencyRef"
        },
        "animationBasis": {
          "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/dependencyRef"
        }
      },
      "required": [
