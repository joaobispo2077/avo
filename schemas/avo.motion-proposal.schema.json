          "properties": {
            "reducedMotion": {
              "type": "boolean"
            },
            "flashingSafe": {
              "type": "boolean"
            }
          }
        },
        "providerPatternRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "enum": [
            "hyperframes",
            "remotion",
            "code-drawn"
          ]
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmap",
            "bmap",
            "tracks"
          ],
          "properties": {
            "cmap": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bmap": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "tracks": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "formatDiagnosis",
        "density",
        "safeZones",
        "components",
        "accessibility",
        "framework"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/proposeRequest"
    },
    {
      "$ref": "#/$defs/selectRequest"
    },
    {
      "$ref": "#/$defs/applyRequest"
    }
  ]
