                  "order": {
                    "type": "integer"
                  },
                  "role": {
                    "enum": [
                      "base",
                      "clip",
                      "image",
                      "text",
                      "card",
                      "graphic",
                      "caption",
                      "grade",
                      "end-screen",
                      "overlay"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "sizeBytes"
                    ],
                    "properties": {
                      "sha256": {
                        "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/sha256"
                      },
                      "sizeBytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "locator": {
                        "type": "string"
                      },
                      "generator": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "locator"
                        ],
                        "not": {
                          "required": [
                            "generator"
                          ]
                        }
                      },
                      {
                        "required": [
                          "generator"
                        ],
                        "not": {
                          "required": [
                            "locator"
                          ]
                        }
                      }
                    ]
                  },
                  "generator": {
                    "type": "object"
                  },
                  "regions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "startTicks",
                        "endTicks",
                        "cueIds",
                        "regionId"
                      ],
                      "properties": {
                        "timebase": {
                          "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/timebase"
                        },
                        "startTicks": {
                          "type": "integer"
                        },
                        "endTicks": {
                          "type": "integer"
                        },
                        "cueIds": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        },
                        "gainDb": {
                          "type": "number"
                        },
                        "fadeInTicks": {
                          "type": "integer"
                        },
                        "fadeOutTicks": {
                          "type": "integer"
                        },
                        "ducking": {
                          "type": "object"
                        },
                        "regionId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{2,63}$"
                        }
                      }
                    }
                  },
                  "zOrder": {
                    "type": "integer"
                  },
                  "fit": {
                    "enum": [
                      "contain",
                      "cover",
                      "fill",
                      "none"
                    ]
                  },
                  "crop": {
                    "type": "object"
                  },
                  "safeZones": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "faceAvoidance": {
                    "type": "boolean"
                  },
                  "composite": {
                    "type": "object"
                  },
                  "animationRef": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "provenance": {
                    "type": "object"
                  },
                  "placement": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  },
                  "captionAvoidance": {
                    "type": "boolean"
                  },
                  "generatedSourceRef": {
                    "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/generatedSourceRef"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "generatedSourceRef"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "source"
                        ]
                      },
                      "properties": {
                        "generator": {
                          "type": "object",
