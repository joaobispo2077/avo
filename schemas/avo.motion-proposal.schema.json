                        "startTicks": {
                          "type": "integer"
                        },
                        "endTicks": {
                          "type": "integer"
                        },
                        "cueIds": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        },
                        "gainDb": {
                          "type": "number"
                        },
                        "fadeInTicks": {
                          "type": "integer"
                        },
                        "fadeOutTicks": {
                          "type": "integer"
                        },
                        "ducking": {
                          "type": "object"
                        },
                        "regionId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{2,63}$"
                        }
                      }
                    }
                  },
                  "channels": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "gainDb": {
                    "type": "number"
                  },
                  "fades": {
                    "type": "object"
                  },
                  "ducking": {
                    "type": "object"
                  },
                  "mute": {
                    "type": "boolean"
