                  "role": {
                    "enum": [
                      "dialogue",
                      "music",
                      "sfx",
                      "ambience",
                      "source-audio"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "sizeBytes"
                    ],
                    "properties": {
                      "sha256": {
                        "$ref": "https://avo.local/avo.tracks.schema.json#/$defs/sha256"
                      },
                      "sizeBytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "locator": {
                        "type": "string"
                      },
                      "generator": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "locator"
                        ],
                        "not": {
                          "required": [
                            "generator"
                          ]
                        }
                      },
                      {
