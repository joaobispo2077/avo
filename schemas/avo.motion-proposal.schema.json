                "properties": {
                  "reducedMotion": {
                    "type": [
                      "string",
                      "boolean"
                    ]
                  }
                }
              },
              "extensions": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "codeDrawn": {
                    "$ref": "https://avo.local/avo.animation.schema.json#/$defs/codeDrawnInstanceRef"
                  }
                }
              }
            }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reducedMotion",
            "flashingSafe"
