                    "type": "string",
                    "minLength": 1
                  },
                  "entrance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exit": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "audioRelationship": {
                "type": "object",
                "additionalProperties": true
              },
              "accessibility": {
                "type": "object",
