{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/avo.timeline-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "migrationId",
    "status",
    "source",
    "tool",
    "outputs",
    "findings",
    "history",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "migrationId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "not-started",
        "assessed",
        "dry-run-ready",
        "dry-run-passed",
        "awaiting-confirmation",
        "applied-unverified",
        "validated",
        "canonical-active",
        "blocked",
        "rollback-required",
        "rolled-back"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "configSha256"
      ],
      "properties": {
        "name": {
          "const": "avo-migrate-timeline"
        },
        "version": {
          "type": "string"
        },
        "configSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactType",
          "path",
          "sha256"
        ],
        "properties": {
          "artifactType": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "classification",
          "message"
        ]
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "occurredAt",
          "actor",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "enum": [
        "legacy",
        "canonical"
      ]
    },
    "legacyPreservedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "confirmation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}
