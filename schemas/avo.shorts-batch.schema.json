{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avo.local/contracts/shorts-batch-request.schema.json",
  "title": "AVO Shorts Batch Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "batchId",
    "provider",
    "source",
    "destination",
    "language",
    "requestedCount",
    "output",
    "defaults",
    "candidates",
    "approvalGates"
  ],
  "properties": {
    "version": {
      "enum": ["1.0", "1.1", "1.2"]
    },
    "batchRoot": { "type": "string", "minLength": 1 },
    "batchRootSource": {
      "enum": ["canonical-default", "invocation", "legacy-output"]
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masterPath"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "masterPath": {
          "type": "string",
          "minLength": 1
        },
        "transcriptPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "expectedFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "destination": {
      "enum": [
        "youtube-shorts",
        "tiktok",
        "reels"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "requestedCount": {
      "type": "integer",
      "minimum": 1
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "maxDurationSec"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "default": 1080
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "default": 1920
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 30
        },
        "maxDurationSec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        },
        "videoCodec": {
          "type": "string",
          "default": "h264"
        },
        "audioSampleRateHz": {
          "type": "integer",
          "minimum": 8000,
          "default": 48000
        },
        "audioChannels": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "loudnessPreset": {
          "type": "string",
          "minLength": 1,
          "description": "Optional AVO loudness preset applied to the rendered proof before artifact hashing."
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryFormat": {
          "type": "string"
        },
        "hybridFormats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewerIntent": {
          "type": "string"
        },
        "trafficPosture": {
          "type": "string"
        },
        "sourceLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "informationDensity": {
          "type": "string"
        },
        "rightsNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privacySafetyDisclosureNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed",
        "layout",
        "captions"
      ],
      "properties": {
        "speed": {
          "$ref": "#/$defs/speedPolicy"
        },
        "layout": {
          "$ref": "#/$defs/layoutPolicy"
        },
        "captions": {
          "$ref": "#/$defs/captionPolicy"
        },
        "review": {
          "type": "object",
          "additionalProperties": true
        },
        "delivery": {
          "type": "object",
          "additionalProperties": true
        },
        "sfx": {
          "$ref": "#/$defs/sfxLibrary"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "insertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insertionPolicy"
      },
      "default": []
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      },
      "default": []
    },
    "approvalGates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "batch-plan",
          "motion-proof",
          "picture-lock",
          "rights",
          "pre-master"
        ]
      }
    }
  },
    "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSec",
        "endSec"
      ],
      "properties": {
        "startSec": {
          "type": "number",
          "minimum": 0
        },
        "endSec": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "startSec", "endSec", "corner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": { "enum": ["chip", "stamp"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "corner": { "enum": ["bl", "br", "bc"] }
      }
    },
    "punchIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startSec", "endSec"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.2
        }
      }
    },
    "graphicSfx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["chip", "stamp", "punch", "seam", "price"] },
        "every": {
          "enum": [
            "start",
            "fill",
            "item",
            "resolve",
            "reject",
            "confirm",
            "badge",
            "role",
            "downbeat",
            "wipe"
          ]
        },
        "offsetSec": { "type": "number" },
        "atSec": { "type": "number", "minimum": 0 }
      }
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "widget", "startSec", "endSec", "corner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "widget": {
          "enum": [
            "stars",
            "stack-resolve",
            "vs-reject",
            "flip-180",
            "cover-wipe",
            "ratio-lock",
            "duration-meter",
            "two-roles",
            "badge-pair",
            "price-duel"
          ]
        },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "corner": { "enum": ["bl", "br", "bc"] },
        "params": {
          "type": "object",
          "minProperties": 1
        },
        "sfx": {
          "anyOf": [
            { "$ref": "#/$defs/graphicSfx" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/graphicSfx" }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "widget": { "const": "stars" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["total", "filled"],
                "properties": {
                  "total": { "type": "integer", "minimum": 1 },
                  "filled": { "type": "integer", "minimum": 0 },
                  "label": { "type": "string", "minLength": 1 },
                  "fillStaggerSec": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "stack-resolve" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["items", "resolve", "resolveAtSec"],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        { "type": "string", "minLength": 1 },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["text"],
                          "properties": {
                            "text": { "type": "string", "minLength": 1 },
                            "startSec": { "type": "number", "minimum": 0 }
                          }
                        }
                      ]
                    }
                  },
                  "resolve": { "type": "string", "minLength": 1 },
                  "resolveAtSec": { "type": "number", "minimum": 0 },
                  "itemStaggerSec": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "vs-reject" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["reject", "confirm", "badge"],
                "properties": {
                  "reject": { "$ref": "#/$defs/timedText" },
                  "confirm": { "$ref": "#/$defs/timedText" },
                  "badge": { "$ref": "#/$defs/timedText" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "flip-180" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["front", "back"],
                "properties": {
                  "front": { "type": "string", "minLength": 1 },
                  "back": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "cover-wipe" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["cover", "hidden", "wipeAtSec"],
                "properties": {
                  "cover": { "type": "string", "minLength": 1 },
                  "hidden": { "type": "string", "minLength": 1 },
                  "wipeAtSec": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "ratio-lock" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["ratio"],
                "properties": { "ratio": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "duration-meter" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["label", "ticks", "metacritic", "metacriticAtSec"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "hours": { "type": ["string", "number"] },
                  "ticks": { "type": "integer", "minimum": 1 },
                  "fillStaggerSec": { "type": "number", "exclusiveMinimum": 0 },
                  "metacritic": { "type": "string", "minLength": 1 },
                  "metacriticAtSec": { "type": "number", "minimum": 0 },
                  "meterHoldSec": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "two-roles" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["roles", "downbeat", "downbeatAtSec"],
                "properties": {
                  "roles": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "oneOf": [
                        { "type": "string", "minLength": 1 },
                        { "$ref": "#/$defs/timedText" }
                      ]
                    }
                  },
                  "roleStaggerSec": { "type": "number", "exclusiveMinimum": 0 },
                  "downbeat": { "type": "string", "minLength": 1 },
                  "downbeatAtSec": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "badge-pair" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["badges"],
                "properties": {
                  "badges": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "$ref": "#/$defs/timedText" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "widget": { "const": "price-duel" } }, "required": ["widget"] },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "additionalProperties": false,
                "required": ["physical", "digital"],
                "properties": {
                  "physical": { "type": "string", "minLength": 1 },
                  "digital": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "timedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "atSec"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "atSec": { "type": "number", "minimum": 0 }
      }
    },
    "sfxLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library"],
      "properties": {
        "library": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chip": { "type": "string", "minLength": 1 },
            "stamp": { "type": "string", "minLength": 1 },
            "punch": { "type": "string", "minLength": 1 },
            "seam": { "type": "string", "minLength": 1 },
            "price": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "speedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "minimum",
        "maximum",
        "preservePitch"
      ],
      "properties": {
        "default": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "preservePitch": {
          "const": true
        },
        "perShortAllowed": {
          "type": "boolean",
          "default": true
        },
        "intelligibilityReviewRequiredAbove": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "layoutPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "captionAnchor"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full-frame",
            "split"
          ]
        },
        "captionAnchor": {
          "enum": [
            "auto",
            "top",
            "bottom",
            "center",
            "seam"
          ]
        },
        "paneOrder": {
          "enum": [
            "base-first",
            "insertion-first"
          ]
        },
        "splitRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "cropMode": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "focusPoint": {
          "$ref": "#/$defs/point"
        },
        "protectedRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rect"
          }
        },
        "safeMargins": {
          "$ref": "#/$defs/margins"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "captionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "continuousDuringSpeech",
        "anchor",
        "grouping",
        "timing",
        "highlight"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "default": "anchor"
        },
        "continuousDuringSpeech": {
          "type": "boolean"
        },
        "anchor": {
          "enum": [
            "auto",
            "top",
            "bottom",
            "center",
            "seam"
          ]
        },
        "grouping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxWords",
            "maxCharacters",
            "maxDurationSec",
            "maxGapSec"
          ],
          "properties": {
            "maxWords": {
              "type": "integer",
              "minimum": 1
            },
            "maxCharacters": {
              "type": "integer",
              "minimum": 1
            },
            "maxDurationSec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxGapSec": {
              "type": "number",
              "minimum": 0
            },
            "mergeOrphans": {
              "type": "boolean"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumHoldSec",
            "frameEpsilon",
            "tailPadSec",
            "autofixPolicy"
          ],
          "properties": {
            "minimumHoldSec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frameEpsilon": {
              "type": "number",
              "minimum": 0
            },
            "tailPadSec": {
              "type": "number",
              "minimum": 0
            },
            "autofixPolicy": {
              "enum": [
                "report-and-fix",
                "fail"
              ]
            }
          }
        },
        "highlight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "resetAtPhraseBoundary"
          ],
          "properties": {
            "mode": {
              "const": "moving-background"
            },
            "punchSelection": {
              "enum": [
                "explicit",
                "last-content-word"
              ]
            },
            "resetAtPhraseBoundary": {
              "const": true
            }
          }
        },
        "maxWidthPx": {
          "type": "integer",
          "minimum": 1
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "coreIdea",
        "viewerPromise",
        "postingTitle",
        "sourceEvidence",
        "editorialApprovalReference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "coreIdea": {
          "type": "string",
          "minLength": 1
        },
        "viewerPromise": {
          "type": "string",
          "minLength": 1
        },
        "postingTitle": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidence": {
          "type": "string",
          "minLength": 1
        },
        "sourceRange": {
          "$ref": "#/$defs/timeRange"
        },
        "sourceSegments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceSegment" }
        },
        "requestedSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layoutOverride": {
          "$ref": "#/$defs/layoutPolicy"
        },
        "captionOverride": {
          "$ref": "#/$defs/captionPolicy"
        },
        "motionOverride": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "callouts": {
              "type": "array",
              "items": { "$ref": "#/$defs/callout" }
            },
            "punchIns": {
              "type": "array",
              "items": { "$ref": "#/$defs/punchIn" }
            },
            "graphics": {
              "type": "array",
              "items": { "$ref": "#/$defs/graphic" }
            }
          }
        },
        "insertionOverride": {
          "type": [
            "string",
            "null"
          ]
        },
        "rightsNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "factualNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "editorialApprovalReference": {
          "type": "string",
          "minLength": 1
        },
        "visualInterestScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "insertionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourcePath",
        "approvedWindows",
        "videoStream",
        "repeatMode",
        "supportVolume",
        "allocation",
        "rightsBasis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "videoStream": {
          "type": "string",
          "minLength": 1
        },
        "audioStream": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedWindows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeRange"
          }
        },
        "excludedWindows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeRange"
          },
          "default": []
        },
        "repeatMode": {
          "const": "finite-repeat"
        },
        "supportVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allocation": {
          "$ref": "#/$defs/allocation"
        },
        "layoutRole": {
          "enum": [
            "secondary-pane"
          ]
        },
        "rightsBasis": {
          "type": "string",
          "minLength": 1
        },
        "riskNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticApprovalReference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explicit",
            "count",
            "percentage"
          ]
        },
        "candidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "roundingRule": {
          "enum": [
            "floor",
            "ceil",
            "nearest"
          ]
        },
        "selectionRule": {
          "enum": [
            "explicit",
            "lowest-visual-interest",
            "ordered"
          ]
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "match",
        "reason",
        "approved"
      ],
      "properties": {
        "scopeCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "operation": {
          "enum": [
            "replace",
            "merge",
            "split",
            "omit"
          ]
        },
        "match": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "replacement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "sourceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "sourceId", "startSec", "endSec", "rationale", "evidenceReference"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceReference": { "type": "string", "minLength": 1 },
        "overlapApprovalReference": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "bottom": {
          "type": "integer",
          "minimum": 0
        },
        "left": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": "1.0" } }, "required": ["version"] },
      "then": {
        "properties": {
          "defaults": { "not": { "required": ["sfx"] } },
          "candidates": {
            "items": {
              "required": ["sourceRange"],
              "allOf": [
                { "not": { "required": ["sourceSegments"] } },
                { "not": { "required": ["motionOverride"] } }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "1.1" } }, "required": ["version"] },
      "then": {
        "required": ["batchRoot", "batchRootSource"],
        "properties": {
          "source": { "required": ["sourceId"] },
          "defaults": { "not": { "required": ["sfx"] } },
          "candidates": {
            "items": {
              "required": ["sourceSegments"],
              "allOf": [
                { "not": { "required": ["sourceRange"] } },
                { "not": { "required": ["motionOverride"] } }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": "1.2" } }, "required": ["version"] },
      "then": {
        "required": ["batchRoot", "batchRootSource"],
        "properties": {
          "source": { "required": ["sourceId"] },
          "candidates": { "items": { "required": ["sourceSegments"], "not": { "required": ["sourceRange"] } } }
        }
      }
    }
  ]
}
